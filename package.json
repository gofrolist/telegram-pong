{
  "name": "telegram-pong",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "bun run --filter @pong/game-core build && bun run --filter @pong/server build && bun run --filter @pong/client build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "dev:server": "bun run --filter @pong/server dev",
    "dev:client": "bun run --filter @pong/client dev",
    "db:migrate": "bun run --filter @pong/server db:migrate",
    "db:generate": "bun run --filter @pong/server db:generate"
  },
  "workspaces": [
    "packages/*"
  ]
}
