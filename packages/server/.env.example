# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# From @BotFather: /newbot, then /token
TELEGRAM_BOT_TOKEN=123456:AA...
# Bot username WITHOUT the leading @
TELEGRAM_BOT_USERNAME=your_pong_bot
# The Mini App short name registered with /newapp
TELEGRAM_APP_NAME=pong
# Any long random string. Telegram echoes it in X-Telegram-Bot-Api-Secret-Token
# on every webhook call; without it the webhook is an open command channel.
TELEGRAM_WEBHOOK_SECRET=change-me-to-32-random-characters

# ---------------------------------------------------------------------------
# Origins
# ---------------------------------------------------------------------------
# This server's public HTTPS origin (fly.io app URL, or a tunnel locally).
PUBLIC_SERVER_URL=https://your-app.fly.dev
# The Mini App's public origin (Vercel). Used for the CORS allowlist.
PUBLIC_CLIENT_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Neon POOLED connection string — the one with `-pooler` in the host.
# The direct endpoint runs out of connections under a machine holding many rooms.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/pong?sslmode=require
# The DIRECT (non-pooled) string. Migrations only: pgbouncer cannot hold the
# session advisory lock a migration needs.
MIGRATION_DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/pong?sslmode=require

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# At least 32 characters. Distinct from the bot token.
SESSION_SECRET=change-me-to-a-long-random-string-32-plus
SESSION_TTL_SEC=3600
# Reject initData older than this. Telegram's own default is a day; the Mini
# App refreshes initData on every launch, so a short window costs nothing.
INIT_DATA_MAX_AGE_SEC=900

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# Per-chat leaderboards depend on chat_instance behaving as documented.
# Leave this false until you have run docs/CHAT-INSTANCE-VERIFICATION.md.
CHAT_LEADERBOARDS_ENABLED=false
ROOM_CREATE_LIMIT_PER_HOUR=30

# setWebhook is GLOBAL per bot token. A local server that registers itself
# steals every update from the deployed one, so keep this false off-production.
TELEGRAM_REGISTER_WEBHOOK=false

PORT=2567
NODE_ENV=development

# Development only: injects artificial latency for Stage-5 netcode testing.
SIMULATED_LATENCY_MS=0
