{
  "name": "@pong/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --conditions=development --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env build/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "node --env-file-if-exists=.env --import tsx node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env --conditions=development --import tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.18.10",
    "@colyseus/schema": "5.0.23",
    "@colyseus/tools": "0.18.3",
    "@colyseus/uwebsockets-transport": "0.18.2",
    "@pong/game-core": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@telegram-apps/init-data-node": "^2.0.10",
    "colyseus": "0.18.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "grammy": "^1.46.0",
    "jose": "^6.1.0",
    "postgres": "^3.4.9",
    "uwebsockets-express": "^2.0.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.2",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.1",
    "drizzle-kit": "^0.31.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
