{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && bun run --filter @pong/game-core build && bun run --filter @pong/client build",
  "outputDirectory": "dist",
  "installCommand": "cd ../.. && bun install --frozen-lockfile",
  "framework": null,
  "headers": [
    {
      "comment": "Telegram's webview caches aggressively enough that a deploy can stay invisible for hours. index.html must never be cached; the hashed assets it points at can be cached forever, which is what makes the pair safe.",
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "comment": "The Mini App is loaded inside Telegram's webview and must not be framable by anyone else.",
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://web.telegram.org https://*.telegram.org"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
